<?php

namespace App\Imports;

use Maatwebsite\Excel\Concerns\WithMultipleSheets;

/**
 * Orkestrator import multi-sheet: kartu-hutang → HutangSheetImport, kartu-piutang → PiutangSheetImport.
 * Dipanggil di dalam DB::transaction di ImportPaymentController::process.
 * Jika 1 sheet throw ValidationException, transaksi luar (savepoint) akan rollback total.
 * Sheet #3 (FORMAT_EXCEL) diabaikan — hanya HUTANG/PIUTANG + legacy yang diproses (2 sheet pertama).
 */
class HutangPiutangImport implements WithMultipleSheets
{
    public HutangSheetImport $hutang;
    public PiutangSheetImport $piutang;

    public function __construct()
    {
        $this->hutang = new HutangSheetImport();
        $this->piutang = new PiutangSheetImport();
    }

    public function sheets(): array
    {
        // Index-based: sheet 0 = HUTANG/kartu-hutang → HutangSheetImport, sheet 1 = PIUTANG/kartu-piutang → PiutangSheetImport
        // Sheet #3 (FORMAT_EXCEL) otomatis diabaikan karena hanya 2 importer
        return [
            $this->hutang,
            $this->piutang,
        ];
    }
}
