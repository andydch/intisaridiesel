<?php

namespace App\Exceptions;

use Illuminate\Foundation\Exceptions\Handler as ExceptionHandler;
use Throwable;

class Handler extends ExceptionHandler
{
    /**
     * A list of the exception types that are not reported.
     *
     * @var array
     */
    protected $dontReport = [
        //
    ];

    /**
     * A list of the inputs that are never flashed for validation exceptions.
     *
     * @var array
     */
    protected $dontFlash = [
        'current_password',
        'password',
        'password_confirmation',
    ];

    /**
     * Register the exception handling callbacks for the application.
     *
     * @return void
     */
    public function register()
    {
        $this->reportable(function (Throwable $e) {
            //
        });
    }

    /**
     * Render an exception into an HTTP response.
     * Menangkap error koneksi database (connection refused / too many connections)
     * agar user tidak melihat halaman error mentah, melainkan halaman ramah 503.
     *
     * @param  \Illuminate\Http\Request  $request
     * @param  \Throwable  $exception
     * @return \Illuminate\Http\Response|\Symfony\Component\HttpFoundation\Response
     */
    public function render($request, Throwable $exception)
    {
        if ($this->isDatabaseConnectionError($exception)) {
            // Catat kejadian dengan penanda khusus agar mudah dipantau di log
            \Log::warning('DATABASE_CONNECTION_REFUSED', [
                'url' => $request->fullUrl(),
                'ip' => $request->ip(),
                'exception' => get_class($exception),
                'message' => $exception->getMessage(),
                'time' => now()->format('Y-m-d H:i:s'),
            ]);

            // Request AJAX/JSON diberi respon JSON agar frontend bisa menangani sendiri
            if ($request->expectsJson()) {
                return response()->json([
                    'status' => 'error',
                    'message' => 'Server sedang sibuk. Silakan coba lagi.',
                ], 503);
            }

            return response()->view('errors.db-connection', [], 503);
        }

        return parent::render($request, $exception);
    }

    /**
     * Deteksi apakah exception berkaitan dengan gagal koneksi database.
     *
     * @param  \Throwable  $e
     * @return bool
     */
    protected function isDatabaseConnectionError(Throwable $e)
    {
        $msg = $e->getMessage();

        return str_contains($msg, 'Connection refused')
            || str_contains($msg, 'Too many connections')
            || str_contains($msg, 'SQLSTATE[HY000] [2002]')
            || str_contains($msg, 'SQLSTATE[HY000] [2003]')
            || str_contains($msg, 'SQLSTATE[HY000] [1040]')
            || str_contains($msg, 'No such file or directory')
            || preg_match('/Can\'t connect/i', $msg)
            || str_contains($msg, 'php_network_getaddresses')
            || str_contains($msg, 'Connection timed out');
    }
}
